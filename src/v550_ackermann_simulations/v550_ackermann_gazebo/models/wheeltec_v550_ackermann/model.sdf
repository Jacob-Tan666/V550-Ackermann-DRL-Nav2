      <sensor name="akm_imu" type="imu">
        <always_on>true</always_on><update_rate>100</update_rate>
        <plugin name="v550_imu" filename="libgazebo_ros_imu_sensor.so">
          <ros><remapping>~/out:=imu</remapping></ros>
        </plugin>
      </sensor>

      <sensor name="v550_lidar" type="ray">
        <pose>-0.075 0 0.540 0 0 0</pose>
        <always_on>true</always_on><visualize>false</visualize><update_rate>15</update_rate>
        <ray>
          <scan><horizontal><samples>360</samples><resolution>1.0</resolution><min_angle>-3.141593</min_angle><max_angle>3.141593</max_angle></horizontal></scan>
          <range><min>0.12</min><max>10.0</max></range>
        </ray>
        <plugin name="v550_laserscan" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>base_scan</frame_name>
        </plugin>
      </sensor>
    </link>
    <!-- RB WHEEL -->
    <joint name="rb_wheel_joint" type="revolute">
      <pose relative_to="base_footprint">-0.05574 -0.08000 0.0332 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>rb_wheel_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-100000</lower><upper>100000</upper><effort>18.0</effort><velocity>45</velocity></limit><dynamics><damping>0.006</damping><friction>0.001</friction></dynamics></axis>
    </joint>
    <link name="rb_wheel_link">
      <pose relative_to="rb_wheel_joint">0 0 0 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0002</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name="rb_wheel_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://wheeltec_v550_ackermann/meshes/rb_wheel_link.STL</uri></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient></material>
      </visual>
      <visual name="rb_wheel_teal_hub">
        <pose>0 -0.011 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.00 0.62 0.70 1</ambient><diffuse>0.00 0.78 0.86 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
      </visual>
      <!-- Collision is rotated 90 deg around X (roll) to align cylinder Z-axis with Y-axis -->
      <collision name="rb_wheel_collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.0332</radius><length>0.026</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.4</mu><mu2>1.2</mu2><slip1>0.001</slip1><slip2>0.001</slip2></ode></friction>
          <contact><ode><kp>500000.0</kp><kd>100.0</kd></ode></contact>
        </surface>
      </collision>
    </link>
    <!-- LB WHEEL -->
    <joint name="lb_wheel_joint" type="revolute">
      <pose relative_to="base_footprint">-0.05574 0.08000 0.0332 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>lb_wheel_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-100000</lower><upper>100000</upper><effort>18.0</effort><velocity>45</velocity></limit><dynamics><damping>0.006</damping><friction>0.001</friction></dynamics></axis>
    </joint>
    <link name="lb_wheel_link">
      <pose relative_to="lb_wheel_joint">0 0 0 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0002</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name="lb_wheel_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://wheeltec_v550_ackermann/meshes/lb_wheel_link.STL</uri></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient></material>
      </visual>
      <visual name="lb_wheel_teal_hub">
        <pose>0 0.011 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.00 0.62 0.70 1</ambient><diffuse>0.00 0.78 0.86 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
      </visual>
      <!-- Collision is rotated 90 deg around X (roll) to align cylinder Z-axis with Y-axis -->
      <collision name="lb_wheel_collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.0332</radius><length>0.026</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.4</mu><mu2>1.2</mu2><slip1>0.001</slip1><slip2>0.001</slip2></ode></friction>
          <contact><ode><kp>500000.0</kp><kd>100.0</kd></ode></contact>
        </surface>
      </collision>
    </link>
    <!-- RF STEERING DUMMY -->
    <joint name="rf_steer_joint" type="revolute">
      <pose relative_to="base_footprint">0.08751 -0.08000 0.0332 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>rf_steer_link</child>
      <!-- Z axis is inverted for ackermann plugin convention -->
      <axis><xyz>0 0 -1</xyz><limit><lower>-0.45</lower><upper>0.45</upper><effort>1.2</effort><velocity>3.0</velocity></limit><dynamics><damping>0.08</damping><friction>0.02</friction></dynamics></axis>
    </joint>
    <link name="rf_steer_link">
      <pose relative_to="rf_steer_joint">0 0 0 0 0 0</pose>
      <inertial><mass>0.10</mass><inertia><ixx>5e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>5e-5</iyy><iyz>0</iyz><izz>5e-5</izz></inertia></inertial>
    </link>
    <!-- RF WHEEL -->
    <joint name="rf_wheel_joint" type="revolute">
      <pose relative_to="rf_steer_link">0 0 0 0 0 0</pose>
      <parent>rf_steer_link</parent>
      <child>rf_wheel_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-100000</lower><upper>100000</upper><effort>1.0</effort><velocity>45</velocity></limit><dynamics><damping>0.004</damping><friction>0.001</friction></dynamics></axis>
    </joint>
    <link name="rf_wheel_link">
      <pose relative_to="rf_wheel_joint">0 0 0 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0002</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name="rf_wheel_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://wheeltec_v550_ackermann/meshes/rf_wheel_link.STL</uri></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient></material>
      </visual>
      <visual name="rf_wheel_teal_hub">
        <pose>0 -0.011 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.00 0.62 0.70 1</ambient><diffuse>0.00 0.78 0.86 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
      </visual>
      <!-- Collision is rotated 90 deg around X (roll) to align cylinder Z-axis with Y-axis -->
      <collision name="rf_wheel_collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.0332</radius><length>0.026</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.4</mu><mu2>1.2</mu2><slip1>0.001</slip1><slip2>0.001</slip2></ode></friction>
          <contact><ode><kp>500000.0</kp><kd>100.0</kd></ode></contact>
        </surface>
      </collision>
    </link>
    <!-- LF STEERING DUMMY -->
    <joint name="lf_steer_joint" type="revolute">
      <pose relative_to="base_footprint">0.08751 0.08000 0.0332 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>lf_steer_link</child>
      <!-- Z axis is inverted for ackermann plugin convention -->
      <axis><xyz>0 0 -1</xyz><limit><lower>-0.45</lower><upper>0.45</upper><effort>1.2</effort><velocity>3.0</velocity></limit><dynamics><damping>0.08</damping><friction>0.02</friction></dynamics></axis>
    </joint>
    <link name="lf_steer_link">
      <pose relative_to="lf_steer_joint">0 0 0 0 0 0</pose>
      <inertial><mass>0.10</mass><inertia><ixx>5e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>5e-5</iyy><iyz>0</iyz><izz>5e-5</izz></inertia></inertial>
    </link>
    <!-- LF WHEEL -->
    <joint name="lf_wheel_joint" type="revolute">
      <pose relative_to="lf_steer_link">0 0 0 0 0 0</pose>
      <parent>lf_steer_link</parent>
      <child>lf_wheel_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-100000</lower><upper>100000</upper><effort>1.0</effort><velocity>45</velocity></limit><dynamics><damping>0.004</damping><friction>0.001</friction></dynamics></axis>
    </joint>
    <link name="lf_wheel_link">
      <pose relative_to="lf_wheel_joint">0 0 0 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0002</iyy><iyz>0</iyz><izz>0.0001</izz></inertia></inertial>
      <visual name="lf_wheel_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://wheeltec_v550_ackermann/meshes/lf_wheel_link.STL</uri></mesh></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient></material>
      </visual>
      <visual name="lf_wheel_teal_hub">
        <pose>0 0.011 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.020</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.00 0.62 0.70 1</ambient><diffuse>0.00 0.78 0.86 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
      </visual>
      <!-- Collision is rotated 90 deg around X (roll) to align cylinder Z-axis with Y-axis -->
      <collision name="lf_wheel_collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry><cylinder><radius>0.0332</radius><length>0.026</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.4</mu><mu2>1.2</mu2><slip1>0.001</slip1><slip2>0.001</slip2></ode></friction>
          <contact><ode><kp>500000.0</kp><kd>100.0</kd></ode></contact>
        </surface>
      </collision>
    </link>
    <plugin name="v550_ackermann_drive" filename="libv550_safe_ackermann_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>

      <update_rate>100.0</update_rate>

      <front_left_joint>lf_wheel_joint</front_left_joint>
      <front_right_joint>rf_wheel_joint</front_right_joint>
      <rear_left_joint>lb_wheel_joint</rear_left_joint>
      <rear_right_joint>rb_wheel_joint</rear_right_joint>

      <left_steering_joint>lf_steer_joint</left_steering_joint>
      <right_steering_joint>rf_steer_joint</right_steering_joint>

      <wheel_separation>0.160</wheel_separation>
      <wheel_base>0.1432</wheel_base>
      <wheel_radius>0.0332</wheel_radius>

      <min_steer>-0.35</min_steer>
      <max_steer>0.35</max_steer>

      <max_speed>1.5</max_speed>
      <max_steering_angle>0.35</max_steering_angle>

      <!-- PID gains for steering; rear drive uses a bounded velocity motor. -->
      <right_steering_pid_gain>8.0 0.0 0.12</right_steering_pid_gain>
      <left_steering_pid_gain>8.0 0.0 0.12</left_steering_pid_gain>
      <steering_torque_limit>1.00</steering_torque_limit>
      <drive_torque_limit>0.60</drive_torque_limit>
      <brake_torque_limit>0.80</brake_torque_limit>
      <command_timeout>0.50</command_timeout>
      <parking_brake>true</parking_brake>
      <parking_linear_threshold>0.10</parking_linear_threshold>
      <parking_angular_threshold>0.50</parking_angular_threshold>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <publish_distance_to_center>true</publish_distance_to_center>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <plugin name="v550_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>joint_states:=joint_states_raw</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>rf_wheel_joint</joint_name>
      <joint_name>lf_wheel_joint</joint_name>
      <joint_name>rb_wheel_joint</joint_name>
      <joint_name>lb_wheel_joint</joint_name>
      <joint_name>rf_steer_joint</joint_name>
      <joint_name>lf_steer_joint</joint_name>
    </plugin>

  </model>
</sdf>
