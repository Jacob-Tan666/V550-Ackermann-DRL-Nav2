<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="wheeltec_v550_ackermann">
    <pose>0 0 0 0 0 0</pose>

    <!-- CHASSIS -->
    <link name="base_footprint">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.010 0.0 0.095 0 0 0</pose>
        <mass>12.0</mass>
        <inertia><ixx>0.18</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.24</iyy><iyz>0</iyz><izz>0.32</izz></inertia>
      </inertial>
      <!-- Keep the low underbody clear of the inset wheels, including at full steer. -->
      <collision name="base_collision">
        <pose>0.005 0 0.107 0 0 0</pose>
        <geometry><box><size>0.310 0.190 0.080</size></box></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          <contact><ode><kp>500000.0</kp><kd>100.0</kd></ode></contact>
        </surface>
      </collision>
      <collision name="center_underbody_collision">
        <pose>0.005 0 0.067 0 0 0</pose>
        <geometry><box><size>0.310 0.100 0.050</size></box></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          <contact><ode><kp>500000.0</kp><kd>100.0</kd></ode></contact>
        </surface>
      </collision>

      <sensor name="base_bumper" type="contact">
        <always_on>true</always_on>
        <update_rate>100.0</update_rate>
        <contact><collision>base_collision</collision></contact>
        <plugin name="base_bumper_plugin" filename="libgazebo_ros_bumper.so">
          <ros><remapping>bumper_states:=bumper_states</remapping></ros>
          <frame_name>base_footprint</frame_name>
        </plugin>
      </sensor>

      <visual name="base_visual">
        <pose>0 0 0.030 0 0 0</pose>
        <geometry><mesh><uri>model://wheeltec_v550_ackermann/meshes/base_link.STL</uri></mesh></geometry>
