      <pose>-1.05 4.95 0 0 0 1.1</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision"><pose>0 0 0.38 0 0 0</pose><geometry><box><size>0.72 0.62 0.76</size></box></geometry></collision>
        <visual name="visual"><pose>0 0 0.38 0 0 0</pose><geometry><box><size>0.72 0.62 0.76</size></box></geometry><material><ambient>0.70 0.43 0.18 1</ambient><diffuse>0.70 0.43 0.18 1</diffuse></material></visual>
      </link>
