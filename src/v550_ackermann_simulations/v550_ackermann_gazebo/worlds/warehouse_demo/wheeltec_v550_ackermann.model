        <visual name="visual"><pose>0 0 0.50 0 0 0</pose><geometry><cylinder><radius>0.30</radius><length>1.0</length></cylinder></geometry><material><ambient>0.88 0.18 0.08 1</ambient><diffuse>0.88 0.18 0.08 1</diffuse></material></visual>
