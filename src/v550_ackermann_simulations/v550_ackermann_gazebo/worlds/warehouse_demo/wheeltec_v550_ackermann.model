    <model name="obstacle4">
      <pose>6.35 -5.05 0 0 0 0.55</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>0.78 0.78 0.84</size></box></geometry>
        </collision>
        <visual name="inspection_station">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>0.78 0.78 0.84</size></box></geometry>
          <material><ambient>0.20 0.24 0.26 1</ambient><diffuse>0.20 0.24 0.26 1</diffuse></material>
        </visual>
        <visual name="status_light">
          <pose>0 0 0.90 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.0 0.9 0.35 1</ambient><diffuse>0.0 0.9 0.35 1</diffuse><emissive>0.0 0.8 0.25 1</emissive></material>
        </visual>
      </link>
    </model>

