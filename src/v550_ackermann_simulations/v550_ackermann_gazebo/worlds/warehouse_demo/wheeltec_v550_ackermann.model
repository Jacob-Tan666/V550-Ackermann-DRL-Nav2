<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <physics default="true" name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.24 0.25 0.26 1</ambient>
      <background>0.48 0.52 0.55 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.55 0.53 0.50 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>-0.35 0.20 -0.92</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <light name="loading_bay_key_light" type="point">
      <pose>-1.0 -2.6 4.5 0 0 0</pose>
      <diffuse>0.32 0.30 0.26 1</diffuse>
      <specular>0.04 0.04 0.04 1</specular>
      <attenuation>
        <range>9</range>
        <constant>0.8</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <light name="inspection_lane_blue_light" type="point">
      <pose>2.8 2.8 3.2 0 0 0</pose>
      <diffuse>0.08 0.14 0.24 1</diffuse>
      <specular>0.02 0.03 0.04 1</specular>
      <attenuation>
        <range>6</range>
        <constant>0.9</constant>
        <linear>0.12</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="open_factory_floor_visual">
      <static>true</static>
      <link name="visual_floor">
        <collision name="stable_factory_floor_collision">
          <pose>0 0 -0.010 0 0 0</pose>
          <geometry><box><size>16.0 20.0 0.020</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
            <contact><ode><kp>500000.0</kp><kd>100.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="matte_floor">
          <pose>0 0 -0.006 0 0 0</pose>
          <geometry><box><size>16.0 20.0 0.012</size></box></geometry>
          <material>
            <ambient>0.32 0.33 0.33 1</ambient>
            <diffuse>0.42 0.43 0.43 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="warehouse_boundary_walls">
      <static>true</static>
      <link name="walls">
        <collision name="north_wall_collision">
          <pose>0 9.85 0.65 0 0 0</pose>
          <geometry><box><size>15.70 0.25 1.30</size></box></geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>0 9.85 0.65 0 0 0</pose>
          <geometry><box><size>15.70 0.25 1.30</size></box></geometry>
          <material><ambient>0.38 0.39 0.38 1</ambient><diffuse>0.48 0.49 0.48 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <collision name="south_wall_collision">
          <pose>0 -9.85 0.65 0 0 0</pose>
          <geometry><box><size>15.70 0.25 1.30</size></box></geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>0 -9.85 0.65 0 0 0</pose>
          <geometry><box><size>15.70 0.25 1.30</size></box></geometry>
          <material><ambient>0.38 0.39 0.38 1</ambient><diffuse>0.48 0.49 0.48 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <collision name="west_wall_collision">
          <pose>-7.85 0 0.65 0 0 0</pose>
          <geometry><box><size>0.25 19.70 1.30</size></box></geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-7.85 0 0.65 0 0 0</pose>
          <geometry><box><size>0.25 19.70 1.30</size></box></geometry>
          <material><ambient>0.38 0.39 0.38 1</ambient><diffuse>0.48 0.49 0.48 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
        <collision name="east_wall_collision">
          <pose>7.85 0 0.65 0 0 0</pose>
          <geometry><box><size>0.25 19.70 1.30</size></box></geometry>
        </collision>
        <visual name="east_wall_visual">
          <pose>7.85 0 0.65 0 0 0</pose>
          <geometry><box><size>0.25 19.70 1.30</size></box></geometry>
          <material><ambient>0.38 0.39 0.38 1</ambient><diffuse>0.48 0.49 0.48 1</diffuse><specular>0.02 0.02 0.02 1</specular></material>
        </visual>
      </link>
    </model>

    <include><uri>model://demo_storage_rack</uri><name>storage_rack_nw_far</name><pose>-5.15 6.55 0 0 0 0</pose></include>
    <include><uri>model://demo_storage_rack</uri><name>storage_rack_nc_far</name><pose>-1.35 6.55 0 0 0 0</pose></include>
    <include><uri>model://demo_storage_rack</uri><name>storage_rack_ne_far</name><pose>3.60 6.55 0 0 0 0</pose></include>
    <include><uri>model://demo_storage_rack</uri><name>storage_rack_w_upper</name><pose>-4.70 3.45 0 0 0 0</pose></include>
    <include><uri>model://demo_storage_rack</uri><name>storage_rack_e_upper</name><pose>3.40 3.45 0 0 0 0</pose></include>
    <include><uri>model://demo_storage_rack</uri><name>storage_rack_w_mid_vertical</name><pose>-5.55 0.00 0 0 0 1.5708</pose></include>
    <include><uri>model://demo_storage_rack</uri><name>storage_rack_e_mid_vertical</name><pose>5.75 0.00 0 0 0 1.5708</pose></include>
    <include><uri>model://demo_storage_rack</uri><name>storage_rack_w_lower</name><pose>-4.70 -3.45 0 0 0 0</pose></include>
    <include><uri>model://demo_storage_rack</uri><name>storage_rack_e_lower</name><pose>3.40 -3.45 0 0 0 0</pose></include>
    <include><uri>model://demo_storage_rack</uri><name>storage_rack_sw_far</name><pose>-5.00 -6.45 0 0 0 0</pose></include>
    <include><uri>model://demo_storage_rack</uri><name>storage_rack_sc_far</name><pose>-0.40 -6.45 0 0 0 0</pose></include>
    <include><uri>model://demo_storage_rack</uri><name>storage_rack_se_far</name><pose>4.40 -6.45 0 0 0 0</pose></include>

    <model name="obstacle1">
      <pose>-4.00 5.10 0 0 0 0.25</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.95 0.72 0.90</size></box></geometry>
        </collision>
        <visual name="pallet_base">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>1.05 0.78 0.16</size></box></geometry>
          <material><ambient>0.38 0.25 0.12 1</ambient><diffuse>0.38 0.25 0.12 1</diffuse></material>
        </visual>
        <visual name="crate_stack">
          <pose>0 0 0.48 0 0 0</pose>
          <geometry><box><size>0.90 0.66 0.72</size></box></geometry>
          <material><ambient>0.62 0.39 0.18 1</ambient><diffuse>0.62 0.39 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle2">
      <pose>6.55 5.35 0 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <pose>0 0 0.52 0 0 0</pose>
          <geometry><cylinder><radius>0.36</radius><length>1.04</length></cylinder></geometry>
        </collision>
        <visual name="barrel_visual">
          <pose>0 0 0.52 0 0 0</pose>
          <geometry><cylinder><radius>0.36</radius><length>1.04</length></cylinder></geometry>
          <material><ambient>0.05 0.22 0.84 1</ambient><diffuse>0.05 0.22 0.84 1</diffuse></material>
        </visual>
        <visual name="barrel_band">
          <pose>0 0 0.76 0 0 0</pose>
          <geometry><cylinder><radius>0.365</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.95 0.95 0.90 1</ambient><diffuse>0.95 0.95 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle3">
      <pose>-5.60 -4.85 0 0 0 -0.8</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>1.05 0.32 0.84</size></box></geometry>
        </collision>
        <visual name="safety_rail">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>1.05 0.32 0.84</size></box></geometry>
          <material><ambient>0.98 0.72 0.04 1</ambient><diffuse>0.98 0.72 0.04 1</diffuse></material>
        </visual>
