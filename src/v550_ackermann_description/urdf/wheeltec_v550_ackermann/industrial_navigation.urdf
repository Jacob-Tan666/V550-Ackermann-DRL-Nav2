  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/>
  </joint>
  <joint name="rb_wheel_joint" type="continuous">
    <limit effort="8.0" velocity="45.0"/>
    <dynamics damping="0.08" friction="0.005"/>
    <parent link="base_link"/>
    <child link="rb_wheel_link"/>
    <origin xyz="-0.05574 -0.08000 0.03320" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="lb_wheel_joint" type="continuous">
    <limit effort="8.0" velocity="45.0"/>
    <dynamics damping="0.08" friction="0.005"/>
    <parent link="base_link"/>
    <child link="lb_wheel_link"/>
    <origin xyz="-0.05574 0.08000 0.03320" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="rf_steer_joint" type="revolute">
    <limit lower="-0.45" upper="0.45" effort="8.0" velocity="3.0"/>
    <dynamics damping="0.35" friction="0.10"/>
    <parent link="base_link"/>
    <child link="rf_steer_link"/>
    <origin xyz="0.08751 -0.08000 0.03320" rpy="0 0 0"/>
    <!-- Match Gazebo SDF steering convention. -->
    <axis xyz="0 0 -1"/>
  </joint>
  <joint name="rf_wheel_joint" type="continuous">
    <limit effort="1.0" velocity="45.0"/>
    <dynamics damping="0.03" friction="0.001"/>
    <parent link="rf_steer_link"/>
    <child link="rf_wheel_link"/>
    <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="lf_steer_joint" type="revolute">
    <limit lower="-0.45" upper="0.45" effort="8.0" velocity="3.0"/>
    <dynamics damping="0.35" friction="0.10"/>
    <parent link="base_link"/>
    <child link="lf_steer_link"/>
    <origin xyz="0.08751 0.08000 0.03320" rpy="0 0 0"/>
    <!-- Match Gazebo SDF steering convention. -->
    <axis xyz="0 0 -1"/>
  </joint>
  <joint name="lf_wheel_joint" type="continuous">
    <limit effort="1.0" velocity="45.0"/>
    <dynamics damping="0.03" friction="0.001"/>
    <parent link="lf_steer_link"/>
    <child link="lf_wheel_link"/>
    <origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="base_scan"/>
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.075 0 0.540" rpy="0 0 0"/>
  </joint>

  <gazebo reference="rb_wheel_link">
    <mu1>1.4</mu1>
    <mu2>1.2</mu2>
    <kp>500000.0</kp>
    <kd>100.0</kd>
  </gazebo>
