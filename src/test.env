# ROS2 domain id for network communication, machines with the same ID will receive each others' messages
export ROS_DOMAIN_ID=1

# Resolve the WHEELTEC V550 navigation workspace from this file's location.
export DRLNAV_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Allow Gazebo to find the V550 and industrial warehouse models.
export GAZEBO_MODEL_PATH="${GAZEBO_MODEL_PATH:+${GAZEBO_MODEL_PATH}:}${DRLNAV_BASE_PATH}/src/v550_ackermann_simulations/v550_ackermann_gazebo/models"

# Source the workspace
source /opt/ros/humble/setup.bash
source "${DRLNAV_BASE_PATH}/install/setup.bash"
